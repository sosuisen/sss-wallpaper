<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.sosuisha</groupId>
  <artifactId>sss-wallpaper</artifactId>
  <version>1.0-SNAPSHOT</version>
  <description>SSS Wallpaper - sets a different wallpaper on each monitor</description>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.plugin.version>0.0.8</javafx.plugin.version>
    <!-- The static JavaFX libraries for the native exe must come from the same
         commit as the JavaFX jars, and none exist for 27.0.1 yet. See ADR 2. -->
    <javafx.version>27</javafx.version>
    <javafx.builder.version>27.0.0</javafx.builder.version>
    <maven.compiler.release>25</maven.compiler.release>
    <main.class>com.sosuisha.main.Launcher</main.class>
    <jspecify.version>1.0.1</jspecify.version>
    <atlantafx.version>3.0.0</atlantafx.version>
    <errorprone.version>2.51.0</errorprone.version>
    <nullaway.version>0.14.3</nullaway.version>
    <junit.version>6.1.3</junit.version>
    <!-- Tests tagged "desktop" change the real wallpaper. Run them with -Pdesktop. -->
    <test.excludedGroups>desktop</test.excludedGroups>
    <test.groups></test.groups>
    <!-- JaCoCo sets argLine to its agent. The empty default keeps
         @{argLine} in surefire valid when JaCoCo does not run. -->
    <argLine></argLine>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.sosuisen</groupId>
      <artifactId>javafx-builder-controls</artifactId>
      <version>${javafx.builder.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.sosuisen</groupId>
      <artifactId>javafx-builder-graphics</artifactId>
      <version>${javafx.builder.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.mkpaz</groupId>
      <artifactId>atlantafx-base</artifactId>
      <version>${atlantafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>4.0.18</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.uber.nullaway</groupId>
      <artifactId>nullaway-annotations</artifactId>
      <version>${nullaway.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <!-- Required by Error Prone. Error Prone needs access to javac
                 internals; the add-exports options are in .mvn/jvm.config. -->
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <!-- The built-in Error Prone checks run with their default levels.
                 Three checks that are off by default are turned on as warnings,
                 and NullAway runs as an error.
                 The javac plugin arguments must be one argument. -->
            <arg>-Xplugin:ErrorProne -Xep:FieldCanBeFinal:WARN -Xep:MethodCanBeStatic:WARN -Xep:PrivateConstructorForUtilityClass:WARN -Xep:NullAway:ERROR -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:AnnotatedPackages=com.sosuisha -XepOpt:NullAway:CustomInitializerAnnotations=org.testfx.framework.junit5.Start</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${errorprone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <!-- Test classes run in parallel across forked JVMs. TestFX needs
               one JavaFX toolkit per JVM, so in-JVM parallelism is not safe. -->
          <forkCount>1C</forkCount>
          <reuseForks>true</reuseForks>
          <!-- DesktopWallpaperService calls restricted FFM methods.
               JavaFX extracts its DLLs into a shared cache on first use. Forks
               that extract at the same time break each other's DLLs, so each
               fork gets its own cache. -->
          <argLine>@{argLine} --enable-native-access=ALL-UNNAMED -Djavafx.cachedir=${project.build.directory}/javafx-cache/${surefire.forkNumber}</argLine>
          <excludedGroups>${test.excludedGroups}</excludedGroups>
          <groups>${test.groups}</groups>
          <systemPropertyVariables>
            <glass.platform>Headless</glass.platform>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.16</version>
        <configuration>
          <excludes>
            <!-- Calls the COM API of Windows and changes the real wallpaper.
                 Only the tests tagged "desktop" run it. -->
            <exclude>com/sosuisha/service/DesktopWallpaperService*</exclude>
            <!-- Starts Explorer, so the normal tests cannot run it. -->
            <exclude>com/sosuisha/service/ExplorerFolderOpener*</exclude>
            <!-- Only ExplorerFolderOpener, which is excluded, throws it. -->
            <exclude>com/sosuisha/domain/exception/FolderOpenException*</exclude>
            <!-- The tests cannot make the drag events with files. -->
            <exclude>com/sosuisha/presentation/FileDrop*</exclude>
            <!-- The entry point. It starts the app or changes the real wallpaper. -->
            <exclude>com/sosuisha/main/Launcher*</exclude>
            <!-- The composition root. It wires the real services. -->
            <exclude>com/sosuisha/main/App*</exclude>
          </excludes>
        </configuration>
        <executions>
          <!-- Adds the agent that records the coverage to the test JVMs. -->
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <!-- Writes the HTML report to target/site/jacoco after the tests. -->
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.30.1</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.3</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>com.sosuisha.*</param>
          </targetClasses>
          <targetTests>
            <param>com.sosuisha.*</param>
          </targetTests>
          <!-- The same classes as the JaCoCo excludes. -->
          <excludedClasses>
            <param>com.sosuisha.service.DesktopWallpaperService*</param>
            <param>com.sosuisha.service.ExplorerFolderOpener*</param>
            <param>com.sosuisha.domain.exception.FolderOpenException*</param>
            <param>com.sosuisha.presentation.FileDrop*</param>
            <param>com.sosuisha.main.Launcher*</param>
            <param>com.sosuisha.main.App*</param>
          </excludedClasses>
          <excludedGroups>
            <param>desktop</param>
          </excludedGroups>
          <!-- The same settings as surefire. The JavaFX DLLs are extracted
               once by the first run, which runs alone. -->
          <jvmArgs>
            <jvmArg>--enable-native-access=ALL-UNNAMED</jvmArg>
            <jvmArg>-Djavafx.cachedir=${project.build.directory}/javafx-cache/pit</jvmArg>
            <jvmArg>-Dglass.platform=Headless</jvmArg>
          </jvmArgs>
          <threads>4</threads>
          <timestampedReports>false</timestampedReports>
        </configuration>
      </plugin>
      <plugin>
        <groupId>net.revelc.code.formatter</groupId>
        <artifactId>formatter-maven-plugin</artifactId>
        <version>2.29.0</version>
        <configuration>
          <configFile>${project.basedir}/java-formatter.xml</configFile>
          <lineEnding>LF</lineEnding>
        </configuration>
        <!-- Formats the sources in process-sources, before every compile. -->
        <executions>
          <execution>
            <goals>
              <goal>format</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.sosuisha</groupId>
        <artifactId>classdiagram-maven-plugin</artifactId>
        <version>1.1.0</version>
        <configuration>
          <packageName>com.sosuisha</packageName>
          <picturesque>true</picturesque>
          <packageStrokeColor>#79754d</packageStrokeColor>
          <packageFillColor>#ebdfc7</packageFillColor>
          <edgeColor>#661d00</edgeColor>
          <interfaceFillColor>#c4ffee</interfaceFillColor>
          <classFillColor>#ecffc4</classFillColor>
          <outputFile>${project.basedir}/docs/classdiagram.svg</outputFile>
          <intentionFile>${project.basedir}/classdiagram.intention</intentionFile>
        </configuration>
        <!-- Draws docs/classdiagram.svg in the compile phase, after the compiler. -->
        <executions>
          <execution>
            <phase>compile</phase>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>${javafx.plugin.version}</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
          <options>
            <option>--enable-native-access=ALL-UNNAMED</option>
          </options>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>desktop</id>
      <properties>
        <test.excludedGroups></test.excludedGroups>
        <test.groups>desktop</test.groups>
      </properties>
    </profile>
    <!-- mvn -Pnative package makes the native exe under target/.
         It needs GraalVM CE 25.4 as JAVA_HOME. See ADR 2. -->
    <profile>
      <id>native</id>
      <properties>
        <jfx.static.libs.version>27-2</jfx.static.libs.version>
      </properties>
      <dependencies>
        <dependency>
          <groupId>us.hebi.graalvm</groupId>
          <artifactId>jfx-static-feature</artifactId>
          <version>1.1.1</version>
        </dependency>
        <dependency>
          <groupId>us.hebi.graalvm</groupId>
          <artifactId>jfx-static-libs</artifactId>
          <version>${jfx.static.libs.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>1.1.18</version>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <phase>package</phase>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <imageName>sss-wallpaper</imageName>
              <mainClass>${main.class}</mainClass>
              <buildArgs>
                <!-- DesktopWallpaperService calls restricted FFM methods. -->
                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                <!-- Embeds the icon in the exe. See src/windows/sss-wallpaper.rc. -->
                <buildArg>-H:NativeLinkerOption=${project.basedir}/src/windows/sss-wallpaper.res</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
